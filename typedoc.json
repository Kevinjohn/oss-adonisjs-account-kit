{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "index.ts",
    "http/main.ts",
    "testing/adapter_contract.ts",
    "testing/notifications.ts"
  ],
  "out": "docs/api",
  "plugin": ["typedoc-plugin-markdown"],
  "entryFileName": "index",
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "hidePageHeader": true,
  "githubPages": false,
  "gitRevision": "main",
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "rewrittenLink": true,
    "notDocumented": true,
    "unusedMergeModuleWith": true
  },
  "requiredToBeDocumented": [
    "Enum",
    "EnumMember",
    "Variable",
    "Function",
    "Class",
    "Interface",
    "Method",
    "Accessor",
    "TypeAlias"
  ]
}
