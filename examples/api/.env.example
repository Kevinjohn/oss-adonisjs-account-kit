# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development
DB_CONNECTION=sqlite
# PostgreSQL connection (DB_CONNECTION=postgres)
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_DATABASE=

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
ACCOUNT_KIT_AUTH_STRATEGY=access_tokens
ACCOUNT_KIT_USERS_TABLE=users
ACCOUNT_KIT_USER_ID_TYPE=integer
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Token clients set this to their exact HTTPS OAuth redirect URI.
SOCIAL_CLIENT_CALLBACK_URL=

# Session
SESSION_DRIVER=cookie

# Limiter
LIMITER_STORE=database
