# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development
DB_CONNECTION=sqlite
# PostgreSQL connection (DB_CONNECTION=postgres)
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_DATABASE=

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
ACCOUNT_KIT_AUTH_STRATEGY=access_tokens
ACCOUNT_KIT_ADMISSION_DOMAINS=
ACCOUNT_KIT_USERS_TABLE=users
ACCOUNT_KIT_USER_ID_TYPE=integer
# These inert values let the local core-flow example boot without an OAuth account.
# Replace them with provider credentials and the exact callback before using social sign-in.
GOOGLE_CLIENT_ID=local-example-google-client-id
GOOGLE_CLIENT_SECRET=local-example-google-client-secret
GITHUB_CLIENT_ID=local-example-github-client-id
GITHUB_CLIENT_SECRET=local-example-github-client-secret
# Token clients use their exact OAuth redirect URI; this local-only callback is not a provider URL.
SOCIAL_CLIENT_CALLBACK_URL=http://localhost:3333/api/v1/auth/oauth/token

# Session
SESSION_DRIVER=cookie

# Limiter
LIMITER_STORE=database
