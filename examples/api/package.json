{
  "name": "account-kit-api-example",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "license": "MIT",
  "exports": {
    "./data": "./.adonisjs/client/data.d.ts",
    "./registry": "./.adonisjs/client/registry/index.ts"
  },
  "scripts": {
    "kit:pack": "pnpm --dir ../.. build && pnpm --dir ../.. pack --out examples/api/vendor/adonisjs-account-kit.tgz",
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "migrate": "node ace migration:run --force",
    "test": "node ace test",
    "test:session": "node ace test --files=tests/functional/session_guard_paused_races.spec.ts --files=tests/functional/session_guard_races.spec.ts --files=tests/functional/reference_session.spec.ts --files=tests/functional/social_session.spec.ts --files=tests/functional/token_reference.spec.ts --files=tests/functional/admission.spec.ts",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.2",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.10.0",
    "eslint": "^10.11.0",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/ally": "^6.3.2",
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.5.2",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/limiter": "^3.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@japa/api-client": "^3.2.1",
    "@tuyau/core": "^1.2.2",
    "@vinejs/vine": "^4.4.0",
    "better-sqlite3": "^12.11.1",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "adonisjs-account-kit": "file:vendor/adonisjs-account-kit.tgz"
  },
  "allowScripts": {
    "@swc/core": true,
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
