@layouts.auth()
  <h1 class="auth__title">Reset your password</h1>
  <p class="auth__sub">
    We will show the same confirmation whether or not an account uses this address.
  </p>
  @form({ route: 'password_resets.store', method: 'POST', class: 'auth__form' })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Email' })
      @!input.control({
        type: 'email',
        autocomplete: 'email',
        value: old('email'),
        required: true,
      })
      @!field.error()
    @end
    @!button({ text: 'Send reset link', type: 'submit', block: true })
  @end

  <p class="auth__foot"><a href="{{ urlFor('session.create') }}" class="il">Back to sign in</a></p>
@end
