@layouts.app({ title: 'Password settings' })
  @page()
    <h1>Change password</h1>
    <p>Changing your password signs out other sessions. Password fields are cleared after validation errors.</p>
    @form({ route: 'passwords.update', method: 'POST', class: 'auth__form' })
      @field.root({ name: 'currentPassword' })
        @!field.label({ text: 'Current password' })
        @!input.control({ type: 'password', autocomplete: 'current-password', required: true })
        @!field.error()
      @end
      @field.root({ name: 'password' })
        @!field.label({ text: 'New password' })
        @!input.control({ type: 'password', autocomplete: 'new-password', required: true })
        @!field.error()
      @end
      @field.root({ name: 'passwordConfirmation' })
        @!field.label({ text: 'Confirm new password' })
        @!input.control({ type: 'password', autocomplete: 'new-password', required: true })
        @!field.error()
      @end
      @!button({ text: 'Change password', type: 'submit' })
    @end
    @link({ route: 'dashboard' })Back to dashboard@end
  @end
@end
