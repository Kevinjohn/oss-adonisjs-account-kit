@let(variant = $props.get('variant') || 'success')
@inject({ variant })
@let(classes = ['alert', `alert--${variant}`])

<div {{
  $props
    .except(['variant'])
    .merge({
      role: 'alert',
      class: classes,
    })
    .toAttrs()
}}>
  <span class="alert__icon">
    @if(variant === 'destructive')
      @svg('lucide:circle-alert', { width: 18, height: 18 })
    @else
      @svg('lucide:circle-check', { width: 18, height: 18 })
    @end
  </span>
  <div class="alert__body">{{{ await $slots.main() }}}</div>
</div>
