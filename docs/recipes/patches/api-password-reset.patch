diff --git a/start/account_kit_routes.ts b/start/account_kit_routes.ts
new file mode 100644
index 0000000..cf22710
--- /dev/null
+++ b/start/account_kit_routes.ts
@@ -0,0 +1,18 @@
+import app from '@adonisjs/core/services/app'
+import router from '@adonisjs/core/services/router'
+import { AccountKit } from 'adonisjs-account-kit'
+import { createManagedGuard, registerManagedRoutes } from 'adonisjs-account-kit/http'
+
+registerManagedRoutes(router, {
+  prefix: '/account-kit',
+  enabled: ['passwordReset'],
+  kit: () => app.container.make(AccountKit),
+  guard: createManagedGuard({
+    strategy: 'access_tokens',
+    name: 'api',
+    loadUser: async () => {
+      const { default: User } = await import('#models/user')
+      return User
+    },
+  }),
+})
