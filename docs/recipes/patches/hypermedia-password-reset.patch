+import type { HttpContext } from '@adonisjs/core/http'
+import type { NextFn } from '@adonisjs/core/types/http'
+import { sendTokenPageHeaders } from '#services/token_page_headers'
+
+/** Apply privacy headers before body parsing, CSRF checks, and route error handling. */
+export default class PasswordResetHeadersMiddleware {
+  async handle(ctx: HttpContext, next: NextFn) {
+    if (ctx.request.url().startsWith('/reset-password/')) {
+      sendTokenPageHeaders(ctx.response)
+    }
+
+    return next()
+  }
+}
