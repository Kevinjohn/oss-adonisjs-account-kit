@@ -0,0 +1,39 @@
+@layouts.auth()
+  <h1 class="auth__title">Choose a new password</h1>
+  @if(valid)
+    <p class="auth__sub">
+      The reset link can be used once. Completing it signs out existing sessions.
+    </p>
+    @form({
+      route: 'password_resets.update',
+      routeParams: { token },
+      method: 'POST',
+      class: 'auth__form',
+    })
+      @field.root({ name: 'password' })
+        @!field.label({ text: 'New password' })
+        @!input.control({
+          type: 'password',
+          autocomplete: 'new-password',
+          required: true,
+        })
+        @!field.error()
+      @end
+      @field.root({ name: 'passwordConfirmation' })
+        @!field.label({ text: 'Confirm password' })
+        @!input.control({
+          type: 'password',
+          autocomplete: 'new-password',
+          required: true,
+        })
+        @!field.error()
+      @end
+      @!button({ text: 'Reset password', type: 'submit', block: true })
+    @end
+  @else
+    <p class="auth__sub">
+      This link is invalid, already used, or expired. Request a new reset link.
+    </p>
+    <a href="{{ urlFor('password_resets.create') }}" class="il">Request a new link</a>
+  @end
+@end
