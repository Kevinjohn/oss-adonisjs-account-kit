diff --git a/app/services/session_guard.ts b/app/services/session_guard.ts
new file mode 100644
index 0000000..4342020
--- /dev/null
+++ b/app/services/session_guard.ts
@@ -0,0 +1,25 @@
+import User from '#models/user'
+import type { HttpContext } from '@adonisjs/core/http'
+
+/**
+ * Lets Account Kit sign users in and out through the existing `web` session guard. The stored
+ * revision is checked on every request by the session revision middleware.
+ */
+export function accountKitSessionGuard(ctx: HttpContext) {
+  const guard = ctx.auth.use('web')
+  return {
+    strategy: 'session' as const,
+    name: 'web',
+    async establish(userId: number | string, revision: string | null) {
+      ctx.session.regenerate()
+      await guard.login(await User.findOrFail(userId))
+      ctx.session.put('accountKitRevision', revision ?? '')
+      return undefined
+    },
+    async terminate() {
+      await guard.logout()
+      ctx.session.clear()
+      ctx.session.regenerate()
+    },
+  }
+}
diff --git a/app/services/token_page_headers.ts b/app/services/token_page_headers.ts
new file mode 100644
index 0000000..2523632
--- /dev/null
+++ b/app/services/token_page_headers.ts
@@ -0,0 +1,38 @@
+import kit from '@kevinjohn/adonisjs-account-kit/services/main'
+import type { HttpContext } from '@adonisjs/core/http'
+
+/**
+ * Prevents reset proof pages and their submission errors from being cached or used as referrers.
+ */
+export function sendTokenPageHeaders(response: HttpContext['response']) {
+  response.header('Cache-Control', 'no-store')
+  response.header('Referrer-Policy', 'no-referrer')
+}
+
+/** Decode only the reset route and allow canonical base64url proof tokens. */
+export function proofRequest(request: HttpContext['request']) {
+  if (!['GET', 'POST'].includes(request.method())) return null
+  const match = /^\/reset-password\/([^/]+)\/?$/.exec(request.url())
+  if (!match) return null
+  let token: string
+  try {
+    token = decodeURIComponent(match[1])
+  } catch {
+    return { token: null, path: null }
+  }
+  const shaped =
+    /^[A-Za-z0-9_-]{22,86}$/.test(token) &&
+    Buffer.from(token, 'base64url').toString('base64url') === token
+  return {
+    token: shaped ? token : null,
+    path: shaped ? `/reset-password/${encodeURIComponent(token)}` : null,
+  }
+}
+
+/** Keep a bearer URL only when its proof still permits correction. */
+export async function proofRecovery(request: HttpContext['request']) {
+  const proof = proofRequest(request)
+  if (!proof) return null
+  if (!proof.token || !proof.path) return '/forgot-password'
+  return (await kit.passwordReset.inspect({ token: proof.token })) ? proof.path : '/forgot-password'
+}
