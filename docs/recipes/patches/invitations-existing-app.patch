@@ -0,0 +1,15 @@
+import type { HttpContext } from '@adonisjs/core/http'
+import type { NextFn } from '@adonisjs/core/types/http'
+
+const invitationProofPath = /^\/api\/v1\/auth\/invitations\/[^/]+\/?$/
+
+/** Protect invitation proof URLs before body parsing or other middleware can reject the request. */
+export default class InvitationProofHeadersMiddleware {
+  handle(ctx: HttpContext, next: NextFn) {
+    if (invitationProofPath.test(ctx.request.url().split('?')[0])) {
+      ctx.response.header('Cache-Control', 'no-store')
+      ctx.response.header('Referrer-Policy', 'no-referrer')
+    }
+    return next()
+  }
+}
