--- /dev/null
+++ b/start/invitation_routes.ts
@@ -0,0 +1,8 @@
+import { middleware } from '#start/kernel'
+import router from '@adonisjs/core/services/router'
+
+router
+  .post('/api/v1/account/invitations', [() => import('#controllers/invitations_controller'), 'send'])
+  .use(middleware.auth())
+router.get('/api/v1/auth/invitations/:token', [() => import('#controllers/invitations_controller'), 'inspect'])
+router.post('/api/v1/auth/invitations/:token', [() => import('#controllers/invitations_controller'), 'accept'])
