+import type { HttpContext } from '@adonisjs/core/http'
+import vine from '@vinejs/vine'
+import { InvalidTokenError } from 'adonisjs-account-kit'
+import accountKit from 'adonisjs-account-kit/services/main'
+
+const sendValidator = vine.compile(
+  vine.object({ email: vine.string().email(), role: vine.string().trim().minLength(1).maxLength(40) })
+)
+const acceptValidator = vine.compile(
+  vine.object({
+    password: vine.string().minLength(8),
+    passwordConfirmation: vine.string().minLength(8),
+    fullName: vine.string().trim().minLength(1).maxLength(100),
+  })
+)
+
+export default class InvitationsController {
+  async send({ auth, request, response }: HttpContext) {
+    const actor = await auth.getUserOrFail()
+    if (!actor.currentAccessToken?.allows('invitations:create')) {
+      return response.forbidden({ error: 'This token cannot create invitations.' })
+    }
+    const { email, role } = await request.validateUsing(sendValidator)
+    const invitation = await accountKit.invitations.send({ actorId: actor.id, email, role })
+    return response.created({ id: invitation.id })
+  }
+
+  async inspect({ params, response }: HttpContext) {
+    const invitation = await accountKit.invitations.inspect({ token: params.token })
+    return invitation ? response.ok(invitation) : response.badRequest({ error: 'Invalid invitation.' })
+  }
+
+  async accept({ params, request, response }: HttpContext) {
+    const { password, passwordConfirmation, fullName } = await request.validateUsing(acceptValidator)
+    if (password !== passwordConfirmation) {
+      return response.unprocessableEntity({ error: 'Password confirmation does not match.' })
+    }
+    try {
+      const user = await accountKit.invitations.accept({
+        token: params.token,
+        password,
+        registrationData: { fullName },
+      })
+      return response.created({ id: user.id, email: user.email })
+    } catch (error) {
+      if (error instanceof InvalidTokenError) return response.badRequest({ error: 'Invalid invitation.' })
+      throw error
+    }
+  }
+}
