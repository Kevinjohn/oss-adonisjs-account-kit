+import db from '@adonisjs/lucid/services/db'
+import type { Trx } from 'adonisjs-account-kit'
+import type { AuthorizationCallbacks } from 'adonisjs-account-kit/types'
+
+async function isOwner(userId: number | string, trx?: Trx): Promise<boolean> {
+  const query = trx ? trx.from('app_user_roles') : db.from('app_user_roles')
+  return Boolean(await query.where('user_id', userId).where('role', 'owner').first())
+}
+
+export const authorizeInvitations: AuthorizationCallbacks = {
+  invite: async (actor, role, context) => role !== 'owner' && isOwner(actor.id, context?.trx),
+  manageInvitation: async (actor, _invitation, context) => isOwner(actor.id, context?.trx),
+  listInvitations: async (actor, context) => isOwner(actor.id, context?.trx),
+}
