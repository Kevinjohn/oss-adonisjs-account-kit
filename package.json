{
  "name": "@kevinjohn/adonisjs-account-kit",
  "description": "Password reset, email verification, invitations and email/password management for AdonisJS",
  "version": "0.3.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests",
    "README-AGENTS.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "main": "build/index.js",
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js",
    "./errors": "./build/src/errors.js",
    "./account_kit_provider": "./build/providers/account_kit_provider.js",
    "./adapters/lucid": "./build/adapters/lucid.js",
    "./adapters/sql": "./build/adapters/sql.js",
    "./adapters/drizzle": "./build/adapters/drizzle.js",
    "./adapters/prisma": "./build/adapters/prisma.js",
    "./testing/adapter_contract": "./build/testing/adapter_contract.js",
    "./testing/notifications": "./build/testing/notifications.js",
    "./services/main": "./build/services/main.js",
    "./http": "./build/http/main.js",
    "./transaction": "./build/transaction/main.js",
    "./ally": "./build/src/ally_social_provider.js",
    "./commands": "./build/commands/main.js",
    "./admission": "./build/src/admission/main.js",
    "./admission/provider": "./build/src/admission/provider.js",
    "./admission/commands": "./build/src/admission/commands/main.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "git ls-files -z | xargs -0 prettier --check --ignore-unknown --no-error-on-unmatched-pattern",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "pretest": "pnpm lint",
    "test": "c8 pnpm quick:test",
    "test:built-exports": "cross-env TEST_BUILT_EXPORTS=1 pnpm quick:test --files=package_exports.spec.ts",
    "test:consumer": "node --import=@poppinss/ts-exec --enable-source-maps bin/test_consumer.ts",
    "test:pg": "bash bin/pg.sh test",
    "pg:start": "bash bin/pg.sh start",
    "pg:stop": "bash bin/pg.sh stop",
    "test:mysql": "cross-env DB_CLIENT=mysql2 TZ=America/New_York pnpm quick:test",
    "check:changed": "node --import=@poppinss/ts-exec --enable-source-maps bin/check_changed.ts",
    "check": "node --import=@poppinss/ts-exec --enable-source-maps bin/check.ts",
    "precompile": "pnpm lint",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration",
    "postcompile": "pnpm copy:templates",
    "build": "pnpm compile",
    "prepare": "node --import=@poppinss/ts-exec bin/prepare.ts",
    "docs:api": "typedoc",
    "docs:dev": "pnpm docs:api && vitepress dev docs",
    "docs:build": "pnpm docs:api && vitepress build docs",
    "copy:templates": "node --import=@poppinss/ts-exec bin/copy_templates.ts",
    "demos": "node --import=@poppinss/ts-exec bin/demos/create_app.ts tmp/demo-app && node --import=@poppinss/ts-exec bin/demos/record.ts tmp/demo-app tmp/demo-casts && node --import=@poppinss/ts-exec bin/demos/render.ts tmp/demo-casts docs/assets/demos",
    "demos:setup": "node --import=@poppinss/ts-exec bin/demos/create_setup_app.ts tmp/setup-demo-app && node --import=@poppinss/ts-exec bin/demos/record_setup.ts tmp/setup-demo-app tmp/setup-demo-casts && node --import=@poppinss/ts-exec bin/demos/render.ts tmp/setup-demo-casts docs/assets/demos",
    "test:built-setup": "cross-env TEST_BUILT_SETUP=1 pnpm quick:test --files=setup_command.spec.ts",
    "test:adapter": "pnpm quick:test --files=lucid_adapter.spec.ts",
    "test:recipe": "node --import=@poppinss/ts-exec bin/test_recipe.ts"
  },
  "keywords": [
    "adonisjs",
    "accounts",
    "password-reset",
    "email-verification",
    "invitations"
  ],
  "author": "Kevinjohn Gallagher",
  "license": "MIT",
  "homepage": "https://kevinjohn.github.io/oss-adonisjs-account-kit/",
  "bugs": {
    "url": "https://github.com/Kevinjohn/oss-adonisjs-account-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevinjohn/oss-adonisjs-account-kit.git"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/core": "^7.0.1",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/i18n": "^3.0.1",
    "@adonisjs/limiter": "^3.0.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.4.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/session": "^8.3.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.3.0",
    "@kevinjohn/adonisjs-lucid-soft-delete": "https://github.com/Kevinjohn/oss-adonisjs-lucid-soft-delete/releases/download/v0.1.3/kevinjohn-adonisjs-lucid-soft-delete-0.1.3.tgz",
    "@poppinss/ts-exec": "^1.5.1",
    "@types/luxon": "^3.0.0",
    "@types/node": "^24.0.0",
    "@vinejs/vine": "^4.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.0",
    "c8": "^12.0.0",
    "cross-env": "^10.1.0",
    "drizzle-orm": "0.45.4",
    "eslint": "^10.14.0",
    "luxon": "^3.0.0",
    "mysql2": "^3.24.6",
    "pg": "^8.0.0",
    "prettier": "^3.8.1",
    "tsdown": "^0.23.4",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/limiter": "^3.0.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.0.0",
    "@adonisjs/session": "^8.1.0",
    "@vinejs/vine": "^4.4.0",
    "luxon": "^3.0.0",
    "typescript": "^5.9.3 || ^6.0.3"
  },
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    },
    "@adonisjs/mail": {
      "optional": true
    },
    "@adonisjs/session": {
      "optional": true
    },
    "@vinejs/vine": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "tsdown": {
    "entry": [
      "./index.ts",
      "./configure.ts",
      "./src/types.ts",
      "./src/errors.ts",
      "./src/ally_social_provider.ts",
      "./providers/account_kit_provider.ts",
      "./adapters/lucid.ts",
      "./adapters/sql.ts",
      "./adapters/drizzle.ts",
      "./adapters/prisma.ts",
      "./testing/adapter_contract.ts",
      "./testing/notifications.ts",
      "./services/main.ts",
      "./http/main.ts",
      "./transaction/main.ts",
      "./commands/main.ts",
      "./commands/prune.ts",
      "./commands/setup.ts",
      "./commands/retirement_impact.ts",
      "./commands/doctor.ts",
      "./commands/invite.ts",
      "./commands/reset_link.ts",
      "./commands/operator_output.ts",
      "./commands/openapi.ts",
      "./src/admission/main.ts",
      "./src/admission/provider.ts",
      "./src/admission/commands/main.ts",
      "./commands/admission_install.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext"
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**",
      "bin/**"
    ],
    "check-coverage": true,
    "statements": 97,
    "lines": 94,
    "branches": 90,
    "functions": 94
  },
  "prettier": "@adonisjs/prettier-config",
  "packageManager": "pnpm@11.23.0"
}
