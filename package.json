{
  "name": "adonisjs-account-kit",
  "description": "Password reset, email verification, invitations and email/password management for AdonisJS",
  "version": "0.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "files": [
    "build",
    "docs",
    "examples/api",
    "!build/bin",
    "!build/tests",
    "!docs/reviews/**",
    "!docs/maintainers/**",
    "!docs/.vitepress/**",
    "!docs/api/**",
    "!docs/assets/**",
    "!docs/PRD*.md",
    "!PLAN*.md",
    "README-AGENTS.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "main": "build/index.js",
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js",
    "./errors": "./build/src/errors.js",
    "./account_kit_provider": "./build/providers/account_kit_provider.js",
    "./providers/account_kit_provider": "./build/providers/account_kit_provider.js",
    "./adapters/lucid": "./build/adapters/lucid.js",
    "./adapters/sql": "./build/adapters/sql.js",
    "./adapters/drizzle": "./build/adapters/drizzle.js",
    "./adapters/prisma": "./build/adapters/prisma.js",
    "./testing/adapter_contract": "./build/testing/adapter_contract.js",
    "./testing/notifications": "./build/testing/notifications.js",
    "./services/main": "./build/services/main.js",
    "./http": "./build/http/main.js",
    "./ally": "./build/src/ally_social_provider.js",
    "./commands": "./build/commands/main.js",
    "./admission": "./build/src/admission/main.js",
    "./admission/provider": "./build/src/admission/provider.js",
    "./admission/commands": "./build/src/admission/commands/main.js"
  },
  "scripts": {
    "copy:templates": "copyfiles \"stubs/**/*.stub\" --up=\"1\" build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "docs:api": "typedoc",
    "docs:dev": "pnpm docs:api && vitepress dev docs",
    "docs:build": "pnpm docs:api && vitepress build docs",
    "demos": "node scripts/demos/create_app.mjs tmp/demo-app && node scripts/demos/record.mjs tmp/demo-app tmp/demo-casts && node scripts/demos/render.mjs tmp/demo-casts docs/assets/demos",
    "demos:setup": "node scripts/demos/create_setup_app.mjs tmp/setup-demo-app && node scripts/demos/record_setup.mjs tmp/setup-demo-app tmp/setup-demo-casts && node scripts/demos/render.mjs tmp/setup-demo-casts docs/assets/demos",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "test:built-exports": "cross-env TEST_BUILT_EXPORTS=1 pnpm quick:test --files=package_exports.spec.ts",
    "test:built-setup": "cross-env TEST_BUILT_SETUP=1 pnpm quick:test --files=setup_command.spec.ts",
    "pretest": "pnpm lint",
    "test": "c8 pnpm quick:test",
    "precompile": "pnpm lint",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration",
    "postcompile": "pnpm copy:templates",
    "build": "pnpm compile",
    "release": "release-it",
    "version": "pnpm build",
    "prepublishOnly": "pnpm build",
    "test:consumer": "node scripts/test_packed_consumer.mjs",
    "test:adapter": "pnpm quick:test --files=lucid_adapter.spec.ts",
    "pg:start": "bash bin/pg.sh start",
    "pg:stop": "bash bin/pg.sh stop",
    "test:pg": "bash bin/pg.sh test",
    "test:mysql": "cross-env DB_CLIENT=mysql2 TZ=America/New_York pnpm quick:test",
    "test:pg-service": "node --test scripts/test_pg_service.mjs"
  },
  "keywords": [
    "adonisjs",
    "accounts",
    "password-reset",
    "email-verification",
    "invitations"
  ],
  "author": "Kevinjohn Gallagher",
  "license": "MIT",
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/core": "^7.0.1",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/i18n": "^3.0.1",
    "@adonisjs/limiter": "^3.0.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.4.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@release-it/conventional-changelog": "^10.0.5",
    "@types/luxon": "^3.0.0",
    "@types/node": "^25.3.5",
    "@vinejs/vine": "^4.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.0.0",
    "c8": "^11.0.0",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "drizzle-orm": "0.45.4",
    "eslint": "^10.0.3",
    "luxon": "^3.0.0",
    "mysql2": "^3.24.6",
    "pg": "^8.0.0",
    "prettier": "^3.8.1",
    "release-it": "^19.2.4",
    "tsdown": "^0.21.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/limiter": "^3.0.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.0.0",
    "@adonisjs/session": "^8.1.0",
    "@vinejs/vine": "^4.4.0",
    "luxon": "^3.0.0",
    "typescript": "^5.9.3 || ^6.0.3"
  },
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    },
    "@adonisjs/mail": {
      "optional": true
    },
    "@adonisjs/session": {
      "optional": true
    },
    "@vinejs/vine": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tsdown": {
    "entry": [
      "./index.ts",
      "./configure.ts",
      "./src/types.ts",
      "./src/errors.ts",
      "./src/ally_social_provider.ts",
      "./providers/account_kit_provider.ts",
      "./adapters/lucid.ts",
      "./adapters/sql.ts",
      "./adapters/drizzle.ts",
      "./adapters/prisma.ts",
      "./testing/adapter_contract.ts",
      "./testing/notifications.ts",
      "./services/main.ts",
      "./http/main.ts",
      "./commands/main.ts",
      "./commands/prune.ts",
      "./commands/setup.ts",
      "./commands/retirement_impact.ts",
      "./commands/doctor.ts",
      "./commands/invite.ts",
      "./commands/reset_link.ts",
      "./commands/operator_output.ts",
      "./commands/openapi.ts",
      "./src/admission/main.ts",
      "./src/admission/provider.ts",
      "./src/admission/commands/main.ts",
      "./commands/admission_install.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext"
  },
  "release-it": {
    "hooks": {
      "before:bump": "pnpm version ${version} --no-git-tag-version --allow-same-version",
      "before:release": "pnpm publish --access public --provenance --no-git-checks"
    },
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": false,
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "prettier": "@adonisjs/prettier-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevinjohn/oss-adonisjs-account-kit.git"
  },
  "packageManager": "pnpm@11.23.0"
}
