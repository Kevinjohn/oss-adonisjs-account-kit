{
  "extends": "@adonisjs/tsconfig/tsconfig.package.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./build"
  },
  "exclude": [
    "node_modules",
    "build",
    "tmp/**",
    "examples/**",
    "stubs/**",
    "docs/maintainers/reviews/**"
  ],
  "include": [
    "index.ts",
    "configure.ts",
    "src/**/*.ts",
    "commands/**/*.ts",
    "providers/**/*.ts",
    "services/**/*.ts",
    "bin/**/*.ts",
    "tests/**/*.ts",
    "docs/**/*.ts",
    "docs/**/*.mts"
  ]
}
